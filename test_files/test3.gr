πρόγραμμα τεστ
    δήλωση income, tax

    αρχή_προγράμματος
    διάβασε income;
    εάν income <= 100 τότε
        tax := 0;
        γράψε tax;
    αλλιώς 
        γράψε tax;
        εάν income <= 300 τότε

            tax := (income - 100) / 10
        αλλιώς
            εάν income <= 7000 τότε
                tax := (300 - 100) / 10 + (income - 300) / 5
            αλλιώς 
                tax := (300 - 100) / 10 + (700 - 30) / 5 + (income - 700) / 2
            εάν_τέλος
        εάν_τέλος
    εάν_τέλος;
    γράψε tax
    τέλος_προγράμματος
