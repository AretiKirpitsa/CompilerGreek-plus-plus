πρόγραμμα τεστ2
    δήλωση β,α


    αρχή_προγράμματος

        β := 0;
        α := 5;
        
        επανάλαβε
            β := β+2;
            γράψε β;    

        μέχρι β >= 10;

        εάν α <= β τότε
            γράψε α;
        αλλιώς
            γράψε β;
        εάν_τέλος

    τέλος_προγράμματος
